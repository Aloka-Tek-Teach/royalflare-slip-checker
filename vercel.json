export default async function handler(req, res) {
  // CORS Headers
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  // Browser එකෙන් කෙලින්ම URL එකට ආවොත් (GET Request)
  if (req.method === 'GET') {
    return res.status(200).json({
      status: 'online',
      message: 'Royal Flare 26 Slip Checker API is running smoothly!'
    });
  }

  if (req.method !== 'POST') {
    return res.status(405).json({ isValid: false, summary: 'Method not allowed.' });
  }

  try {
    const { imageBase64, mimeType = 'image/jpeg', expectedAmount = 3500 } = req.body || {};

    if (!imageBase64) {
      return res.status(400).json({
        isValid: false,
        summary: 'No payment slip image provided for verification.'
      });
    }

    const cleanBase64 = imageBase64.replace(/^data:image\/\w+;base64,/, '');
    const apiKey = process.env.GEMINI_API_KEY;

    if (!apiKey) {
      return res.status(500).json({
        isValid: false,
        summary: 'GEMINI_API_KEY environment variable is not configured on Vercel.'
      });
    }

    const prompt = `You are the official Royal Flare 26 automated banking fraud detection engine.
Analyze this uploaded image strictly to determine if it is an authentic, genuine Sri Lankan bank deposit slip or electronic funds transfer receipt.

EVENT & BENEFICIARY CRITERIA:
- Event: Royal Flare 26 (Sastralians)
- Official Beneficiary Bank: HNB (Hatton National Bank)
- Official Beneficiary Account Number: 125020004322
- Official Beneficiary Name: W.L.T.L. Weerasooriya
- Required Amount: Exactly LKR ${expectedAmount}

CRITICAL RULES:
1. Reject any non-banking image (selfie, person, animal, meme, wallpaper, car, food, generic paper) => isValid: false.
2. Verify beneficiary account number is 125020004322 or name is W.L.T.L. Weerasooriya (or Royal Flare / RF26).
3. Verify detected amount is at least ${expectedAmount}.
4. Respond ONLY with valid raw JSON format containing keys: 
   "isValid" (boolean), "bankName" (string), "detectedAmount" (number), "referenceNumber" (string), "confidence" (number 0-1), "summary" (string).`;

    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [
            {
              parts: [
                { text: prompt },
                {
                  inlineData: {
                    mimeType: mimeType,
                    data: cleanBase64
                  }
                }
              ]
            }
          ],
          generationConfig: {
            responseMimeType: 'application/json'
          }
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      return res.status(500).json({
        isValid: false,
        summary: `Gemini API Error: ${data.error?.message || 'Failed to analyze image'}`
      });
    }

    const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text || '';
    const cleanJson = rawText.replace(/^```(?:json)?\s*|\s*```$/gi, '').trim();
    const result = JSON.parse(cleanJson);

    return res.status(200).json(result);

  } catch (error) {
    return res.status(500).json({
      isValid: false,
      summary: 'Verification failed due to a server error.'
    });
  }
}
